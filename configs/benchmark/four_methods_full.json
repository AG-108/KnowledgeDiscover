  "configuration_sources": {
    "physo": {
      "source": "physo.task.sr.SR/config0",
      "implementation_variant": "dimensionless config0 with free constants; CPU backend in reserved GPU slot",
      "validation_status": "passed",
      "validation_scope": "Independent noiseless fixtures must pass exact structure and relative coefficient L2 < 1e-5 for seeds 0, 1, 2 before main fitting",
      "validation_evidence": "results/calibration/four_methods_20261005/gate.json",
      "budget_basis": "batch128, native n_epochs, LBFGS25x5; common T=300 includes all fitting"
    },
    "sisso": {
      "source": "sissopp.sklearn.SISSORegressor v1.2.6 / kd.model.kd_sisso",
      "implementation_variant": "native CPU SISSO++; training-only tolerance selection across returned dimensions",
      "validation_status": "passed",
      "validation_scope": "Independent noiseless fixtures must pass exact structure and relative coefficient L2 < 1e-5 for seeds 0, 1, 2 before main fitting",
      "validation_evidence": "results/calibration/four_methods_20261005/gate.json",
      "budget_basis": "n_dim2, max_rung2, n_sis_select<=20, n_residual1; common T=300",
      "representational_limits": "finite descriptor depth; no native soft-stop or anytime candidate recovery"
    },
    "symbolicgpt": {
      "source": "kd.model.kd_symbolicgpt",
      "implementation_variant": "synthetic-per-fit Transformer64/2/2; bounded pretraining plus sampling",
      "validation_status": "passed",
      "validation_scope": "Independent noiseless fixtures must pass exact structure and relative coefficient L2 < 1e-5 for seeds 0, 1, 2 before main fitting",
      "validation_evidence": "results/calibration/four_methods_20261005/gate.json",
      "budget_basis": "1500 synthetic examples, <=40 epochs, <=2000 candidates, pretrain fraction0.55; all fit costs within T=300"
    },
    "dlga": {
      "source": "kd.model.kd_dlga",
      "implementation_variant": "DLGA-PDE float64 observational Sin NN1x16 plus exact-Jacobian least squares and native genetic search",
      "validation_status": "passed",
      "validation_scope": "Independent noiseless fixtures must pass exact structure and relative coefficient L2 < 1e-5 for seeds 0, 1, 2 before main fitting",
      "validation_evidence": "results/calibration/four_methods_20261005/gate.json",
      "budget_basis": "1000 Adam, <=10000 neural LS evaluations tol1e-14; surrogate time fraction0.7; population400/generations100; common T=300"
    }
  },
  "devices": {
    "physo": "cuda:0",
    "sisso": "cpu",
    "symbolicgpt": "cuda:0",
    "dlga": "cuda:0"
  },
  "overrides": {
    "models": {
      "physo": {
        "epochs": null,
        "op_names": [
          "add",
          "sub",
          "mul",
          "div",
          "sin",
          "cos",
          "exp",
          "log",
          "sqrt",
          "n2",
          "n3"
        ],
        "fixed_consts": [
          1.0
        ],
        "free_consts_names": [
          "c0",
          "c1",
          "c2"
        ],
        "free_consts_init_val": [
          1.0,
          1.0,
          1.0
        ],
        "parallel_mode": false,
        "n_cpus": 4,
        "stop_reward": 0.99999999,
        "stop_after_n_epochs": 1,
        "run_config_overrides": {
          "learning_config": {
            "batch_size": 128
          },
          "free_const_opti_args": {
            "method_args": {
              "n_steps": 25,
              "tol": 1e-14,
              "lbfgs_func_args": {
                "max_iter": 5,
                "tolerance_grad": 1e-12,
                "tolerance_change": 1e-14,
                "line_search_fn": "strong_wolfe"
              }
            }
          }
        },
        "execution_device": "cpu",
        "use_dataset_function_set": true,
        "search_space_policy": "declared",
        "keep_free_constants": true,
        "keep_fixed_consts": true
      },
      "sisso": {
        "n_dim": 2,
        "max_rung": 2,
        "n_sis_select": 20,
        "n_residual": 1,
        "allowed_ops": [
          "add",
          "sub",
          "mult",
          "div",
          "sin",
          "cos",
          "exp",
          "log",
          "sq",
          "cb"
        ],
        "model_selection": "training_tolerance",
        "use_dataset_function_set": true,
        "search_space_policy": "declared"
      },
      "symbolicgpt": {
        "embedding_size": 64,
        "n_layer": 2,
        "n_head": 2,
        "pretrain_corpus_size": 1500,
        "pretrain_epochs": 40,
        "op_list": [
          "add",
          "sub",
          "mul",
          "div",
          "sin",
          "cos",
          "exp",
          "log",
          "sqrt",
          "pow"
        ],
        "batch_size": 64,
        "num_candidates": 2000,
        "candidate_batch_size": 32,
        "cache_dataset_tensors": true,
        "dataloader_workers": 0,
        "max_conditioning_points": 64,
        "top_p": 0.95,
        "verbose": false,
        "pretrain_time_fraction": 0.55,
        "use_dataset_function_set": true,
        "search_space_policy": "declared"
      },
      "dlga": {
        "epi": 1e-06,
        "input_dim": 2,
        "max_iter": 1000,
        "verbose": false,
        "operators": [
          "u",
          "u_x",
          "u_xx",
          "u_xxx"
        ],
        "precision": "float64",
        "lbfgs_max_iter": 0,
        "hidden_layers": 1,
        "hidden_width": 16,
        "target_derivative": "u_t",
        "learning_rate_decay": 0.3,
        "bias_init_scale": 1.0,
        "least_squares_nfev": 10000,
        "least_squares_tolerance": 1e-14
      }
    }
  }
