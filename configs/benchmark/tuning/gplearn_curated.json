{
  "profile": "full",
  "tasks": ["sr"],
  "models": ["gplearn"],
  "datasets": ["GrammarVAE-1", "Koza-2", "Nguyen-7", "Nguyen-8", "Korns-1", "Korns-7"],
  "seeds": [0],
  "timeout": 180,
  "resume": false,
  "output_dir": "results/tuning/gplearn_curated",
  "overrides": {
    "models": {
      "gplearn": {
        "population_size": 1500,
        "generations": 30,
        "tournament_size": 20,
        "function_set": ["add", "sub", "mul", "div", "sqrt", "log", "sin", "cos", "exp", "n2", "n3"],
        "const_range": [-10.0, 10.0],
        "init_depth": [2, 5],
        "init_method": "half and half",
        "parsimony_coefficient": 0.003,
        "p_crossover": 0.80,
        "p_subtree_mutation": 0.08,
        "p_hoist_mutation": 0.04,
        "p_point_mutation": 0.08,
        "max_samples": 1.0,
        "n_jobs": -1,
        "low_memory": true
      }
    }
  }
}
