{
  "profile": "full",
  "tasks": ["sr"],
  "models": ["gplearn"],
  "datasets": ["*"],
  "seeds": [0],
  "timeout": 180,
  "resume": true,
  "output_dir": "results/tuning/gplearn_dataset_adaptive",
  "overrides": {
    "models": {
      "gplearn": {
        "use_dataset_function_set": true,
        "population_size": 600,
        "generations": 12,
        "tournament_size": 20,
        "function_set": ["add", "sub", "mul", "div", "sqrt", "log", "abs", "sin", "cos", "exp"],
        "const_range": [-10.0, 10.0],
        "init_depth": [2, 6],
        "init_method": "half and half",
        "parsimony_coefficient": 0.001,
        "p_crossover": 0.75,
        "p_subtree_mutation": 0.1,
        "p_hoist_mutation": 0.05,
        "p_point_mutation": 0.1,
        "max_samples": 1.0,
        "n_jobs": 1,
        "low_memory": true
      }
    }
  }
}
