{
  "profile": "full",
  "tasks": ["sr"],
  "models": ["gplearn"],
  "datasets": ["GrammarVAE-1", "Koza-2", "Nguyen-7", "Nguyen-8", "Korns-1", "Korns-7"],
  "seeds": [0],
  "timeout": 180,
  "resume": false,
  "output_dir": "results/tuning/gplearn_exploration",
  "overrides": {
    "models": {
      "gplearn": {
        "population_size": 2000,
        "generations": 40,
        "tournament_size": 30,
        "function_set": ["add", "sub", "mul", "div", "sqrt", "log", "abs", "sin", "cos", "exp"],
        "const_range": [-10.0, 10.0],
        "init_depth": [2, 8],
        "init_method": "half and half",
        "parsimony_coefficient": 0.0002,
        "p_crossover": 0.70,
        "p_subtree_mutation": 0.15,
        "p_hoist_mutation": 0.05,
        "p_point_mutation": 0.10,
        "max_samples": 1.0,
        "n_jobs": -1,
        "low_memory": true
      }
    }
  }
}
