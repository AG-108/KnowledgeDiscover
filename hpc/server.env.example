# Copy to .local/server.env and edit for the host. Never commit the real file.
# KD_PROJECT defaults to the checkout containing the activation script.
KD_STORAGE_ROOT="$HOME/.local/share/kd"
KD_ENV="$KD_STORAGE_ROOT/envs/kd-server"
KD_CONDA_SH="/opt/conda/etc/profile.d/conda.sh"
KD_E2E_SOURCE="$KD_STORAGE_ROOT/external/e2e-source"
KD_E2E_CHECKPOINT="$KD_STORAGE_ROOT/checkpoints/e2e/model1.pt"
JULIA_DEPOT_PATH="$KD_STORAGE_ROOT/.julia"
# Optional site-specific Julia mirror or executable:
# export JULIA_PKG_SERVER="https://your-julia-mirror.example"
# export PYTHON_JULIAPKG_EXE="/path/to/julia"
